        <Placemark>
            <name></name>
            <description><![CDATA[<link rel="stylesheet" type="text/css" href="https://quickmap.dot.ca.gov/css/gm-infowindow.css?v=9" />
<div class="infowindow-content">
    <div class="iw-header">
        <div class="iw-header-left">
            <img class="iw-icon" src="https://quickmap.dot.ca.gov/img/v2/ChainControl.png?v=4" />
            Chain Control
        </div>
    </div>

    <div class="iw-body">
        <h2 class="iw-title">Westbound Highway 32</h2>
        
        <p class="iw-text"><strong>Chain Control level R-2</strong></p>
        <p class="iw-text"><strong>Location: </strong>Junction SR 36</p>
        <p class="iw-text">Chains or traction devices are required on all vehicles except four wheel/ all wheel drive vehicles with snow-tread tires on all four wheels. (Four wheel/all wheel drive vehicles must carry traction devices in chain control areas).</p>
        <p class="iw-text"><strong>Effective from: </strong>11/18/2026 08:08</p>
        <div font-size:xx-small;'>District: 2 Message ID: 9606</div>
        
        <p class="iw-attribution">
            Information courtesy of <strong>Caltrans</strong>
        </p>
    </div>

    <div class="iw-footer">
        <span class="iw-timestamp">Last updated: <strong>11/18/2026</strong> 2:09pm</span>
    </div>
</div>]]></description>
            <styleUrl>#notclosed</styleUrl>
            <Point>
                <coordinates>-121.428022,40.274482</coordinates>
            </Point>
        </Placemark>
        <Placemark>
            <name></name>
            <description><![CDATA[<link rel="stylesheet" type="text/css" href="https://quickmap.dot.ca.gov/css/gm-infowindow.css?v=9" />
<div class="infowindow-content">
    <div class="iw-header">
        <div class="iw-header-left">
            <img class="iw-icon" src="https://quickmap.dot.ca.gov/img/v2/ChainControl.png?v=4" />
            Chain Control
        </div>
    </div>

    <div class="iw-body">
        <h2 class="iw-title">Westbound Highway 36</h2>
        
        <p class="iw-text"><strong>Chain Control level R-1</strong></p>
        <p class="iw-text"><strong>Location: </strong>3 miles west of Chester</p>
        <p class="iw-text">Chains are required on all vehicles except passenger vehicles and light-duty trucks under 6,000 pounds gross weight and equipped with snow tires on at least two drive wheels. Chains must be carried by vehicles using snow tires. All vehicles towing trailers must have chains on one drive axle. Trailers with brakes must have chains on at least one axle.</p>
        <p class="iw-text"><strong>Effective from: </strong>11/18/2026 06:17</p>
        <div font-size:xx-small;'>District: 2 Message ID: 9625</div>
        
        <p class="iw-attribution">
            Information courtesy of <strong>Caltrans</strong>
        </p>
    </div>

    <div class="iw-footer">
        <span class="iw-timestamp">Last updated: <strong>11/18/2026</strong> 2:09pm</span>
    </div>
</div>]]></description>
